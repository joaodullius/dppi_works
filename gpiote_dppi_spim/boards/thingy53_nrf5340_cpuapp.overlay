/*
 * Thingy:53 - ADXL362. The board wires it to spi3 with a GPIO chip select;
 * on the nRF5340 only SPIM4 has hardware CSN, so the sensor is moved to a
 * spi4 node that uses the same pins plus CSN. Zephyr's SPI/sensor drivers
 * are disabled (CONFIG_SPI=n); the app drives SPIM4 with nrfx and applies
 * this node's pinctrl itself.
 */
/delete-node/ &adxl362;

/ {
	chosen {
		app,accel = &adxl362;
	};
};

&pinctrl {
	spi4_accel: spi4_accel {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 29)>,
				<NRF_PSEL(SPIM_MOSI, 0, 28)>,
				<NRF_PSEL(SPIM_MISO, 0, 26)>,
				<NRF_PSEL(SPIM_CSN, 0, 22)>;
		};
	};
};

&spi3 {
	status = "disabled";
};

&spi4 {
	status = "okay";
	pinctrl-0 = <&spi4_accel>;
	pinctrl-1 = <&spi4_accel>;
	pinctrl-names = "default", "sleep";
	cs-gpios = <&gpio0 22 GPIO_ACTIVE_LOW>;

	adxl362: adxl362@0 {
		compatible = "adi,adxl362";
		reg = <0>;
		spi-max-frequency = <8000000>;
		int1-gpios = <&gpio0 19 GPIO_ACTIVE_HIGH>;
	};
};

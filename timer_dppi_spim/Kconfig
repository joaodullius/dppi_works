DT_COMPAT_BOSCH_BMI270 := bosch,bmi270

menu "TIMER -> DPPI -> SPIM accelerometer reader"

choice APP_SENSOR
	prompt "Accelerometer on the SPI bus (chosen app,accel)"
	default APP_SENSOR_BMI270 if $(dt_compat_enabled,$(DT_COMPAT_BOSCH_BMI270))
	default APP_SENSOR_ADXL362

config APP_SENSOR_ADXL362
	bool "ADXL362 (Thingy:53)"

config APP_SENSOR_BMI270
	bool "BMI270 (nRF54L15 TAG)"

endchoice

config APP_SENSOR_ODR_HZ
	int "Sensor output data rate in Hz"
	default 400
	help
	  Rounded down to the nearest rate the sensor supports
	  (ADXL362: 12.5..400 Hz, BMI270: 25..1600 Hz).

config APP_SAMPLE_PERIOD_US
	int "TIMER trigger period in microseconds"
	default 1000
	range 10 1000000
	help
	  A TIMER (chosen app,timer-trigger) starts one SPIM transaction every
	  period, independently of the sensor. Faster than the sensor ODR means
	  repeated samples (flagged by the data-ready bit in the burst); slower
	  than the real ODR silently loses samples, so keep 5-10 % above it.

config APP_SWEEP_PERIODS_US
	string "Comma-separated list of TIMER periods (us) to cycle through (bench)"
	default ""
	help
	  When not empty, the app runs each period for APP_SWEEP_STEP_S seconds
	  and prints per-period totals (transactions, queued, fresh, dropped),
	  then moves to the next. Used to find the minimum timer rate that loses
	  no sample against the sensor's real ODR, and the bus ceiling.

config APP_SWEEP_STEP_S
	int "Seconds per sweep step"
	default 10

config APP_DRAIN_PERIOD_US
	int "Drain period in microseconds"
	default 10000
	range 100 1000000
	help
	  A thread wakes up every period, reads the EasyDMA pointer, pushes the
	  slots that arrived into the message queue and arms the ring wrap.
	  Delivery latency = one period; interrupts per second = 1 / period
	  (wake-up) + 1 / period (wrap), independent of the sample rate.

config APP_RING_SLOTS
	int "Ring size in samples"
	default 256
	range 8 4096
	help
	  Must hold the samples of more than one drain period with slack for
	  timer jitter and scheduling delay; 8 guard slots are added after it.

config APP_QUEUE_DEPTH
	int "Message queue depth in samples"
	default 256
	help
	  Must hold at least one drain's worth of samples plus the worst-case
	  consumer delay.

config APP_QUEUE_FRESH_ONLY
	bool "Drop repeated samples in the drain (data-ready bit clear)"
	default n
	help
	  Transactions faster than the sensor ODR re-read the previous sample.
	  With this option the drain thread checks the data-ready bit in the
	  burst's STATUS byte and only queues new samples, so the queue and the
	  consumer see the sensor's real rate. Skipped samples are counted.

config APP_SPI_FREQ_HZ
	int "SPIM clock frequency in Hz"
	default 4000000

config APP_SPI_CSN_DURATION
	int "IFTIMING.CSNDUR: CSN-to-SCK delay and CSN inactive time, in SPIM core clock cycles"
	default 2
	range 1 255
	help
	  Reset value 2. nrfx raises it automatically only when it applies the
	  nRF54L errata 8 workaround (PRESCALER > 2); at higher SPI clocks it
	  may need a larger value so SCK is settled before the first edge.

config APP_SPI_RX_DELAY
	int "IFTIMING.RXDELAY: MISO sample delay (-1 = driver default)"
	default -1
	range -1 7
	help
	  Only on SPIM instances that have RXDELAY (nRF5340 SPIM4, nRF54L SPIMxx).

config APP_COUNT_STARTED
	bool "Count SPIM STARTED instead of DMA.RX.READY on nRF54L (bench)"
	default n
	help
	  On nRF54L the ring wrap is armed on DMA.RX.READY, the event the
	  datasheet defines as "registers can be written for the next
	  sequence". This option uses STARTED instead, to compare the two
	  (wrap latency, late wraps). No effect on nRF53/52, which have no
	  DMA.RX.READY event.

config APP_RRAM_STANDBY
	bool "Keep the RRAM in standby instead of power-down during idle (nRF54L, bench)"
	depends on HAS_HW_NRF_RRAMC
	default n
	help
	  By default the RRAMC powers the RRAM down in System ON idle, so the
	  first instruction fetch after a wake-up waits for it (measured ~15 us
	  on the nRF54L15). Standby mode (POWER.LOWPOWERCONFIG.MODE) gives a
	  fast wake-up at a higher idle current; the datasheet recommends it
	  together with Constant Latency mode for the lowest latency.

config APP_WRAP_LATENCY_STATS
	bool "Measure the wrap ISR latency (bench)"
	default n
	help
	  Runs the trigger TIMER at 16 MHz and, in the wrap ISR, captures the
	  time elapsed since the trigger COMPARE that started the transaction:
	  DPPI -> SPIM START -> STARTED/DMA.RX.READY -> IRQ -> wrap ISR.
	  Min/avg/max are printed with the reports. Used to
	  compare the Cortex-M33 and the FLPR (RISC-V) on the nRF54L15.

config APP_REQUEST_HFXO
	bool "Request the HFXO so TIMERs run from the crystal"
	default y
	depends on CLOCK_CONTROL_NRF
	help
	  Without it the TIMER (HFCLK) runs from the internal RC oscillator,
	  measured ~0.2% slow against the LFXO based kernel clock. The FLPR has
	  no clock control: there the hfxo_launcher image (launcher/) requests it.

config APP_REPORT_PERIOD_MS
	int "Report period in milliseconds"
	default 1000

endmenu

source "Kconfig.zephyr"

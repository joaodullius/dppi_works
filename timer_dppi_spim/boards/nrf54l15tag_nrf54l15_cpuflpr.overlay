/*
 * nRF54L15 TAG, FLPR core - same wiring as the application core build:
 * BMI270 on spi22 (P1, PERI domain) with hardware CSN on P1.07. The board's
 * FLPR devicetree leaves spi22/bmi270 disabled, so enable them here (the
 * app drives SPIM22 with nrfx; no Zephyr SPI driver is involved).
 */
/ {
	chosen {
		app,accel = &bmi270;
		app,timer-trigger = &timer20;
		app,timer-count = &timer21;
		app,egu = &egu20;
	};
};

&spi22_default {
	group1 {
		psels = <NRF_PSEL(SPIM_SCK, 1, 8)>,
			<NRF_PSEL(SPIM_MOSI, 1, 6)>,
			<NRF_PSEL(SPIM_MISO, 1, 5)>,
			<NRF_PSEL(SPIM_CSN, 1, 7)>;
	};
};

&spi22 {
	status = "okay";
};

&bmi270 {
	status = "okay";
};
